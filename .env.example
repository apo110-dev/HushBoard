# HushBoard is a loopback-only, disposable Zcash testnet demo.
HOST=127.0.0.1
PORT=4173
HUSHBOARD_DB=./data/hushboard.db
HUSHBOARD_MODE=auto
# Safe public default. Set to 1 only for a funded testnet rehearsal after preflight.
HUSHBOARD_ENABLE_LIVE_SENDS=0
HUSHBOARD_WATCH_INTERVAL=2

ZCASH_MODE=testnet
ZALLET_OPERATOR_URL=http://127.0.0.1:41232
ZALLET_OPERATOR_COOKIE=.runtime/operator.cookie
ZALLET_PARTICIPANT_URL=http://127.0.0.1:41233
ZALLET_PARTICIPANT_COOKIE=.runtime/participant.cookie
ZALLET_WALLETS_FILE=.runtime/wallets.json

# One confirmation keeps the hackathon demo short. Raise this for less reorg risk.
ZCASH_MIN_CONFIRMATIONS=1
BOND_ZAT=1000000

# Local demo authorization only; not a production secret/auth system.
ADMIN_KEY=local-demo-only
